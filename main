const reviews=[
['Por que o coração é comparado a uma bomba?','Porque suas contrações impulsionam o sangue pelos vasos sanguíneos, permitindo que oxigênio, nutrientes e outras substâncias cheguem às células.'],
['Qual é a principal diferença entre uma artéria e uma veia?','As artérias conduzem o sangue para fora do coração, enquanto as veias conduzem o sangue de volta a ele. A classificação depende do sentido do fluxo, não da quantidade de oxigênio no sangue.'],
['Por que as paredes dos capilares são tão finas?','Para facilitar as trocas de oxigênio, dióxido de carbono, nutrientes e resíduos entre o sangue e os tecidos do organismo.'],
['Qual é a importância dos pulmões para a circulação sanguínea?','Nos pulmões, o sangue libera dióxido de carbono e recebe oxigênio. Em seguida, retorna ao lado esquerdo do coração para ser distribuído ao corpo.'],
['O que aconteceria se as válvulas venosas não funcionassem adequadamente?','O retorno de sangue, especialmente das pernas, poderia ser prejudicado, favorecendo refluxo, acúmulo de sangue, inchaço e aparecimento de varizes.'],
['Por que o sistema cardiovascular é importante para os outros sistemas do corpo?','Porque transporta oxigênio, nutrientes, hormônios e componentes de defesa, além de levar resíduos aos órgãos responsáveis pela eliminação. Assim, ajuda a manter todos os tecidos funcionando.'],
['Qual é a diferença entre rotação e translação da Terra?','Rotação é o giro da Terra em torno do próprio eixo, relacionado aos dias e às noites. Translação é a volta da Terra ao redor do Sol, relacionada à duração do ano.'],
['Por que a Lua apresenta fases diferentes?','Porque, ao orbitar a Terra, muda a porção da metade lunar iluminada pelo Sol que conseguimos observar. Não é a sombra da Terra que produz as fases.'],
['Qual é a diferença entre um eclipse solar e um eclipse lunar?','No eclipse solar, a Lua fica entre a Terra e o Sol e bloqueia a luz solar para algumas regiões terrestres. No eclipse lunar, a Terra fica entre o Sol e a Lua, projetando sombra sobre a Lua.'],
['Por que as estações do ano são opostas nos hemisférios?','Devido à inclinação do eixo terrestre e à translação: quando um hemisfério está mais inclinado em direção ao Sol, recebe luz mais direta e tem dias mais longos, enquanto o outro recebe luz menos direta.']
];
const state={}; const letters=['A','B','C','D'];
function renderQuestions(group){const list=questions.map((x,i)=>({...x,id:i})).filter(x=>x.group===group);document.getElementById(group+'-questions').innerHTML=list.map(x=>`<article class="q-card" id="q-${x.id}"><div class="q-head"><span class="q-index">QUESTÃO ${x.id+1 < 9 ? x.id+1 : x.id+1} / 20</span><span class="q-topic">${x.tag}</span></div><h3>${x.q}</h3><div class="opts">${x.o.map((o,j)=>`<button type="button" class="opt" data-choose="${x.id}" data-option="${j}" aria-pressed="false"><span class="letter">${letters[j]}</span><span>${o}</span></button>`).join('')}</div><div class="q-actions"><button type="button" class="check-btn" data-check="${x.id}" disabled>Conferir resposta</button><button type="button" class="comment-btn" data-comment="${x.id}" aria-expanded="false">Ler comentário ▾</button><span class="feedback" id="fb-${x.id}" role="status"></span></div><div class="comment hidden" id="comment-${x.id}"><strong>✓ Resposta correta: ${letters[x.a]}) ${x.o[x.a]}</strong><p>${x.c}</p></div></article>`).join('')}
function refresh(){let answered=0,correct=0;for(const [id,s] of Object.entries(state)){if(s.checked){answered++;if(s.choice===questions[id].a)correct++}}document.getElementById('progress-text').textContent=`${answered} de ${questions.length} respondidas`;document.getElementById('score-text').textContent=`${correct} acertos`;document.getElementById('progress-fill').style.width=`${answered/questions.length*100}%`;document.getElementById('progress-track').setAttribute('aria-valuenow',answered);for(const group of ['cardio','astro']){const ids=questions.map((q,i)=>q.group===group?i:null).filter(x=>x!==null);let hits=ids.filter(id=>state[id]?.checked&&state[id].choice===questions[id].a).length;document.getElementById(group+'-score').textContent=`${hits} / ${ids.length} acertos`}}
function draw(id){const q=questions[id],s=state[id]||{},el=document.getElementById(`q-${id}`);el.querySelectorAll('[data-choose]').forEach(b=>{const j=Number(b.dataset.option);b.classList.toggle('selected',j===s.choice&&!s.checked);b.classList.toggle('correct',!!s.checked&&j===q.a);b.classList.toggle('wrong',!!s.checked&&j===s.choice&&j!==q.a);b.setAttribute('aria-pressed',String(j===s.choice));b.disabled=!!s.checked});el.querySelector('[data-check]').disabled=s.choice===undefined||!!s.checked;const fb=el.querySelector('.feedback');fb.className='feedback'+(s.checked?(s.choice===q.a?' good':' bad'):'');fb.textContent=s.checked?(s.choice===q.a?'✓ Você acertou!':'✕ Não foi desta vez. Veja a explicação.') :''}
function switchTab(id){document.querySelectorAll('.tab').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===id)));document.querySelectorAll('.view').forEach(s=>s.classList.toggle('active',s.id===id));document.querySelector('.section-nav').scrollIntoView({behavior:'smooth',block:'start'})}
renderQuestions('cardio');renderQuestions('astro');document.getElementById('review-list').innerHTML=reviews.map(([q,a],i)=>`<article class="review-card"><button class="review-toggle" aria-expanded="false" data-review="${i}"><span>${String(i+1).padStart(2,'0')}. ${q}</span><span>＋</span></button><div class="review-answer hidden" id="review-answer-${i}"><strong>Resposta comentada:</strong> ${a}</div></article>`).join('');
document.addEventListener('click',e=>{const tab=e.target.closest('[data-tab]');if(tab){switchTab(tab.dataset.tab);return}const go=e.target.closest('[data-goto]');if(go){switchTab(go.dataset.goto);return}const choose=e.target.closest('[data-choose]');if(choose){const id=Number(choose.dataset.choose);if(state[id]?.checked)return;state[id]={choice:Number(choose.dataset.option),checked:false};draw(id);return}const check=e.target.closest('[data-check]');if(check){const id=Number(check.dataset.check);if(state[id]?.choice===undefined)return;state[id].checked=true;draw(id);refresh();return}const comm=e.target.closest('[data-comment]');if(comm){const id=Number(comm.dataset.comment),box=document.getElementById(`comment-${id}`);box.classList.toggle('hidden');const expanded=!box.classList.contains('hidden');comm.setAttribute('aria-expanded',String(expanded));comm.textContent=expanded?'Ocultar comentário ▴':'Ler comentário ▾';return}const rv=e.target.closest('[data-review]');if(rv){const box=document.getElementById('review-answer-'+rv.dataset.review);box.classList.toggle('hidden');const expanded=!box.classList.contains('hidden');rv.setAttribute('aria-expanded',String(expanded));rv.lastElementChild.textContent=expanded?'−':'＋';return}});
for(const group of ['cardio','astro'])document.getElementById('reset-'+group).addEventListener('click',()=>{questions.forEach((q,id)=>{if(q.group!==group)return;delete state[id];draw(id);const box=document.getElementById(`comment-${id}`);box.classList.add('hidden');const b=document.querySelector(`[data-comment="${id}"]`);b.setAttribute('aria-expanded','false');b.textContent='Ler comentário ▾'});refresh()});refresh();
</script>
